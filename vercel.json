{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/cv",
      "destination": "https://mason.gmu.edu/~atabarro/TabarrokCV.pdf",
      "permanent": true
    },
    {
      "source": "/cv/",
      "destination": "https://mason.gmu.edu/~atabarro/TabarrokCV.pdf",
      "permanent": true
    },
    {
      "source": "/video/misallocation.mp4",
      "destination": "https://youtu.be/jsg2iN8xHKw",
      "permanent": false
    },
    {
      "source": "/video/modern-principles.mp4",
      "destination": "https://youtu.be/PxuJYaFNRoA",
      "permanent": false
    },
    {
      "source": "/research/chile/:path*",
      "destination": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6842996",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
