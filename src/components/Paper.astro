---
import type { Publication } from '../data/schema';
import { inlineMarkdown, toPlainText } from '../lib/inline';

interface Props {
  paper: Publication;
  /**
   * Where this paper's explainer lives, or null when it has none. Either the
   * paper's own markdown explainer at /research/<id>/ or a long-form one under
   * /explainers/ covering several papers at once.
   */
  explainer?: string | null;
}

const { paper, explainer = null } = Astro.props;

// One lowercase blob per paper drives the client-side filter without
// needing a separate index or any JSON payload.
const haystack = [
  paper.title,
  paper.citation,
  paper.abstract,
  paper.comment,
  paper.year,
]
  .filter(Boolean)
  .map((v) => toPlainText(String(v)))
  .join(' ')
  .toLowerCase();
---

<article class="paper" id={paper.id} data-year={paper.year ?? ''} data-search={haystack}>
  <p class="paper-year">{paper.year ?? ''}</p>

  <div class="paper-body">
    <h3 class="paper-title">
      {paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}
    </h3>

    {(paper.links.length > 0 || explainer) && (
      <p class="paper-links">
        {explainer && (
          <a class="chip chip-accent" href={explainer}>Explainer</a>
        )}
        {paper.links.map((l) => (
          <a class="chip" href={l.url}>{l.label}</a>
        ))}
      </p>
    )}

    {paper.comment && (
      <p class="paper-comment" set:html={inlineMarkdown(paper.comment)} />
    )}

    {paper.abstract && (
      <details class="paper-abstract">
        <summary>Abstract</summary>
        <div set:html={inlineMarkdown(paper.abstract)} />
      </details>
    )}

    {paper.citation && (
      <p class="paper-citation" set:html={inlineMarkdown(paper.citation)} />
    )}
  </div>
</article>

<style>
  /* Year in a left gutter, content in one column of fixed width.
     The column is sized in rem, not ch: `ch` resolves against each element's
     own font-size, so per-element `max-width: 68ch` gave the citation a
     narrower column than the abstract and left every entry ragged. */
  .paper {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, var(--entry));
    column-gap: 1.75rem;
    padding: 1.35rem 0 1.5rem;
    border-bottom: 1px solid var(--rule);
    /* Every entry is an anchor target now, so clear the sticky header and the
       sticky filter toolbar that sits under it. */
    scroll-margin-top: var(--anchor-offset);
  }

  .paper[hidden] { display: none; }

  @media (max-width: 46rem) {
    .paper { grid-template-columns: minmax(0, 1fr); row-gap: 0.1rem; }
  }

  .paper-title {
    font-size: 1.14rem;
    font-weight: 620;
    line-height: 1.3;
    margin: 0 0 0.35rem;
  }

  .paper-title a { color: var(--ink); text-decoration-color: var(--rule); }
  .paper-title a:hover { color: var(--accent); }

  .paper-year {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 620;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    text-align: right;
    /* Optically settle the year onto the title's first baseline. */
    margin: 0;
    padding-top: 0.3rem;
  }

  @media (max-width: 46rem) {
    .paper-year { text-align: left; padding-top: 0; }
    .paper-year:empty { display: none; }
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.5rem;
  }

  .chip {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 560;
    line-height: 1;
    padding: 0.34rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    background: var(--paper-raised);
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip-accent {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent-ink);
  }

  .paper-comment {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0 0 0.55rem;
  }

  .paper-abstract {
    margin: 0 0 0.6rem;
  }

  .paper-abstract summary {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--accent);
    cursor: pointer;
    width: fit-content;
    padding: 0.15rem 0;
    list-style: none;
  }

  .paper-abstract summary::-webkit-details-marker { display: none; }

  .paper-abstract summary::before {
    content: '▸';
    display: inline-block;
    margin-right: 0.4rem;
    transition: transform 0.15s ease;
  }

  .paper-abstract[open] summary::before { transform: rotate(90deg); }

  .paper-abstract > div {
    padding-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .paper-citation {
    font-size: 0.87rem;
    color: var(--ink-faint);
    margin: 0;
  }

  .paper-citation a { color: var(--ink-faint); }
  .paper-citation a:hover { color: var(--accent); }
</style>
