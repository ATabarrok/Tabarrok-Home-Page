---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * The home page runs a full-bleed hero and a card grid, so it keeps the
   * wide frame and manages its own `.wrap`. Text pages use a narrower frame
   * so the header, any toolbar, and the prose share one right edge instead
   * of leaving a third of the page empty beside the reading column.
   */
  wide?: boolean;
}

const { title, description = '', wide = false } = Astro.props;
const frame = wide ? '70rem' : '56rem';
const path = Astro.url.pathname;

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/research/', label: 'Research' },
  { href: '/consulting/', label: 'Consulting' },
];

const full = title === 'Alex Tabarrok' ? title : `${title} — Alex Tabarrok`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    {/* The 404 page is not a real URL, so it gets neither a canonical nor an
        invitation to index it. */}
    {path === '/404/' ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={new URL(path, Astro.site)} />
    )}
    <meta property="og:title" content={full} />
    <meta property="og:type" content="website" />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131317" media="(prefers-color-scheme: dark)" />
  </head>

  <body style={`--page: ${frame}`}>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">Alex Tabarrok</a>
        <nav class="nav" aria-label="Main">
          {nav.map((i) => (
            <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>
              {i.label}
            </a>
          ))}
          <a class="ext" href="https://marginalrevolution.com">Blog</a>
          <a class="ext" href="mailto:Alex.Tabarrok@gmail.com">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class={wide ? '' : 'wrap'}>
        <slot />
      </div>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>Alex Tabarrok · Bartley J. Madden Chair in Economics, George Mason University</p>
        <p>
          <a href="https://scholar.google.com/citations?user=3syuONQAAAAJ&hl=en">Google Scholar</a>
          · <a href="https://mason.gmu.edu/~atabarro/TabarrokCV.pdf">CV</a>
          · <a href="mailto:Alex.Tabarrok@gmail.com">Email</a>
        </p>
      </div>
    </footer>
  </body>
</html>
