---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { publications } from '../data/schema';

import portrait from '../assets/img/alex-tabarrok.jpg';
import mru from '../assets/img/mru.png';
import textbook from '../assets/img/textbook.png';
import blog from '../assets/img/blog.png';
import pubs from '../assets/img/publications.png';
import teachingImg from '../assets/img/teaching.png';
import consultingImg from '../assets/img/consulting.png';

const cards = [
  {
    href: 'https://mru.org/',
    title: 'Marginal Revolution University',
    blurb: 'Free economics education, taught with Tyler Cowen.',
    img: mru,
  },
  {
    href: 'https://marginalrevolution.com/our-textbook',
    title: 'Modern Principles of Economics',
    blurb: 'The textbook, written with Tyler Cowen.',
    img: textbook,
  },
  {
    href: 'https://marginalrevolution.com',
    title: 'Marginal Revolution',
    blurb: 'Small steps toward a much better world, daily since 2003.',
    img: blog,
  },
  {
    href: '/research/',
    title: 'Research & Publications',
    blurb: `${publications.length} papers on law, economics and innovation.`,
    img: pubs,
  },
  {
    href: '/teaching/',
    title: 'Teaching',
    blurb: 'Syllabi for undergraduate and graduate courses.',
    img: teachingImg,
  },
  {
    href: '/consulting/',
    title: 'Consulting',
    blurb: 'Advisory work for firms in and beyond the blockchain space.',
    img: consultingImg,
  },
];
---

<Base
  title="Alex Tabarrok"
  description="Alex Tabarrok is the Bartley J. Madden Chair in Economics at George Mason University, co-author of Modern Principles of Economics and co-founder of Marginal Revolution University."
  wide
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="eyebrow">George Mason University</p>
        <h1>Alex Tabarrok</h1>
        <p class="hero-role">Bartley J. Madden Chair in Economics</p>
        <p class="hero-blurb">
          Economist working on law and economics, political economy, innovation and the
          institutions that let good ideas spread. Co-author of
          <a href="https://marginalrevolution.com/our-textbook">Modern Principles of Economics</a>
          and co-founder of <a href="https://mru.org/">Marginal Revolution University</a>.
        </p>
        <p class="hero-actions">
          <a class="cta" href="/about/">About</a>
          <a class="cta cta-ghost" href="/research/">Research</a>
        </p>
      </div>
      <div class="hero-portrait">
        <Image
          src={portrait}
          alt="Alex Tabarrok"
          widths={[380, 760]}
          sizes="(max-width: 820px) 60vw, 24rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="cards">
      {cards.map((c) => (
        <a class="card" href={c.href}>
          <div class="card-img">
            <Image src={c.img} alt="" widths={[320, 640]} sizes="(max-width: 640px) 92vw, 22rem" loading="lazy" />
          </div>
          <div class="card-body">
            <h2>{c.title}</h2>
            <p>{c.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .hero {
    background:
      radial-gradient(
        62rem 32rem at 12% -10%,
        color-mix(in srgb, var(--accent-soft) 70%, transparent),
        transparent 65%
      ),
      radial-gradient(
        46rem 28rem at 96% 8%,
        color-mix(in srgb, var(--citrus-soft) 55%, transparent),
        transparent 62%
      );
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(2.5rem, 7vw, 5rem);
    margin-top: calc(clamp(2rem, 5vw, 3.5rem) * -1);
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 6vw, 4rem);
    align-items: center;
  }

  @media (max-width: 820px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-portrait { order: -1; max-width: 15rem; }
  }

  .hero h1 {
    font-size: clamp(2.6rem, 1.7rem + 3.8vw, 4.4rem);
    margin-bottom: 0.15em;
  }

  .hero-role {
    font-family: var(--sans);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem);
    font-weight: 560;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  .hero-blurb {
    font-size: 1.08rem;
    color: var(--ink-soft);
    max-width: 44ch;
    margin-bottom: 1.6rem;
  }

  .hero-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; margin: 0; }

  .cta {
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 580;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    background: var(--accent);
    color: var(--paper);
    border: 1px solid var(--accent);
  }

  .cta:hover { filter: brightness(1.08); color: var(--paper); }

  .cta-ghost {
    background: transparent;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .cta-ghost:hover {
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
    color: var(--accent-ink);
    filter: none;
  }

  .hero-portrait img {
    border-radius: 14px;
    box-shadow: var(--shadow);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: transform 0.16s ease, border-color 0.16s ease,
      box-shadow 0.16s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--rule));
    box-shadow: var(--shadow);
    color: var(--ink);
  }

  .card-img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent-soft) 45%, transparent);
  }

  .card-img img { width: 100%; height: 100%; object-fit: cover; }

  .card-body { padding: 1rem 1.15rem 1.25rem; }

  .card-body h2 {
    font-size: 1.02rem;
    font-weight: 620;
    margin-bottom: 0.3rem;
  }

  .card:hover .card-body h2 { color: var(--accent); }

  .card-body p {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin: 0;
  }
</style>
