---
/**
 * The explainers index. Reads the same YAML that declares each piece, so a new
 * block appears here, and on /research/ as a chip if it names papers, with no
 * edit to this page.
 */
import Base from '../../layouts/Base.astro';
import { explainers, publications, explainerHref } from '../../data/schema';

// A summary of the papers behind each piece, rather than the full titles: the
// explainer's own page lists those, and a row here should stay one line. Some
// explainers belong to no paper and get no summary at all.
const rows = explainers.map((e) => {
  const years = e.papers
    .map((id) => publications.find((p) => p.id === id)?.year)
    .filter((y): y is number => typeof y === 'number')
    .sort((a, b) => a - b);

  const span =
    years.length === 0
      ? null
      : years[0] === years[years.length - 1]
        ? String(years[0])
        : `${years[0]}–${years[years.length - 1]}`;

  const count =
    e.papers.length === 0
      ? null
      : e.papers.length === 1
        ? 'One paper'
        : `${e.papers.length} papers`;

  return {
    ...e,
    href: explainerHref(e),
    meta: count ? (span ? `${count} · ${span}` : count) : null,
    // Shown so a reader knows the link leaves the site before they follow it.
    host: e.url ? new URL(e.url).hostname.replace(/^www\./, '') : null,
  };
});
---

<Base
  title="Explainers"
  description="Plain-language explainers by Alex Tabarrok on economics, housing policy, public goods and other topics."
>
  <p class="eyebrow">Plain language</p>
  <h1 class="page-title">Explainers</h1>
  <p class="lede">
    Pieces written for readers who want an argument laid out plainly. Some draw
    together several of my papers. Others are about subjects I have never
    written up formally, but think are worth understanding.
  </p>

  {rows.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="list">
      {rows.map((e) => (
        <li>
          <a href={e.href}>
            <span class="title">{e.title}</span>
            <span class="desc">{e.description}</span>
            {(e.meta || e.host) && (
              <span class="meta">
                {e.meta}
                {e.meta && e.host && <span class="sep"> · </span>}
                {e.host && <span class="host">{e.host}</span>}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 calc(var(--step) * 1.5);
    max-width: 46rem;
    border-top: 1px solid var(--rule);
  }

  .list li { border-bottom: 1px solid var(--rule); }

  .list a {
    display: block;
    padding: 1.15rem 0.25rem;
    text-decoration: none;
    color: var(--ink);
  }

  .list a:hover {
    background: color-mix(in srgb, var(--accent-soft) 40%, transparent);
  }

  .title {
    display: block;
    font-size: 1.12rem;
    font-weight: 620;
    font-family: var(--sans);
    letter-spacing: -0.015em;
    margin-bottom: 0.3rem;
  }

  .list a:hover .title { color: var(--accent); }

  .desc {
    display: block;
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 40rem;
  }

  .meta {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Lowercase, because it is a domain and reads wrong shouted. */
  .host { text-transform: none; letter-spacing: 0.02em; }

  .empty {
    font-family: var(--sans);
    color: var(--ink-faint);
    padding: 2rem 0;
  }
</style>
