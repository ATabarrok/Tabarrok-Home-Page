</Base>

<style>
  /* This explainer's own identity. The frame is the site's; these are not. */
  .explainer {
    --ex-accent: #8a3244;
  }

  @media (prefers-color-scheme: dark) {
    .explainer {
      --ex-accent: #d98e9b;
    }
  }
</style>

<script>
  /* Tokens live on the explainer element rather than :root, so the chart
     colours have to be read from there. */
  const ROOT = document.querySelector('.explainer') as HTMLElement;

  function cssv(n: string) {
    return getComputedStyle(ROOT).getPropertyValue(n).trim();
  }

  const NS = 'http://www.w3.org/2000/svg';

  function el(tag: string, attrs: Record<string, string | number>) {
    const e = document.createElementNS(NS, tag);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }

  /* Rounded-top bar path: square base, radius r on the top corners. */
  function barPath(x: number, y: number, w: number, h: number, r: number) {
    r = Math.min(r, w / 2, h);
    return (
      'M' + x + ',' + (y + h) + ' L' + x + ',' + (y + r) +
      ' Q' + x + ',' + y + ' ' + (x + r) + ',' + y +
      ' L' + (x + w - r) + ',' + y + ' Q' + (x + w) + ',' + y + ' ' + (x + w) + ',' + (y + r) +
      ' L' + (x + w) + ',' + (y + h) + ' Z'
    );
  }

  interface Series { name: string; color: string }
  interface Cat { label: string; sub?: string; values: number[] }
  interface ChartCfg {
    height?: number; ymax: number; ticks?: number[]; barW?: number;
    twoLine?: boolean; series: Series[]; cats: Cat[];
    fmt: (v: number) => string; aria?: string;
  }

  type ChartBox = HTMLElement & { __tip?: HTMLElement };

  function showTip(c: ChartBox, ev: MouseEvent, title: string, val: string) {
    const t = c.__tip;
    if (!t) return;
    const r = c.getBoundingClientRect();
    t.innerHTML = '<b>' + val + '</b><br>' + title;
    t.style.left = ev.clientX - r.left + 'px';
    t.style.top = ev.clientY - r.top + 'px';
    t.style.opacity = '1';
  }

  function hideTip(c: ChartBox) {
    if (c.__tip) c.__tip.style.opacity = '0';
  }

  /* ---------- chart engine (grouped columns) ---------- */
  function drawColumns(container: ChartBox, cfg: ChartCfg) {
    container.innerHTML = '';
    const W = 760;
    const H = cfg.height || 400;
    const padL = 44, padR = 16, padT = 28, padB = cfg.twoLine ? 66 : 46;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const ymax = cfg.ymax, ticks = cfg.ticks || [0, 25, 50, 75, 100];
    const svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': cfg.aria || '' });
    const grid = cssv('--ex-grid'), base = cssv('--ex-baseline');
    const series = cfg.series, cats = cfg.cats;

    const yOf = (v: number) => padT + plotH - (v / ymax) * plotH;

    ticks.forEach((t) => {
      const y = yOf(t);
      svg.appendChild(el('line', { x1: padL, y1: y, x2: W - padR, y2: y, stroke: t === 0 ? base : grid, 'stroke-width': 1 }));
      const tx = el('text', { x: padL - 10, y: y + 4, 'text-anchor': 'end', class: 'c-ax' });
      tx.textContent = String(t);
      svg.appendChild(tx);
    });

    const n = cats.length, gband = plotW / n;
    const barW = cfg.barW || 46, gap = 8;
    const groupW = series.length * barW + (series.length - 1) * gap;

    cats.forEach((cat, ci) => {
      const gx = padL + ci * gband + (gband - groupW) / 2;
      const cl = el('text', { x: padL + ci * gband + gband / 2, y: H - padB + (cfg.twoLine ? 22 : 24), 'text-anchor': 'middle', class: 'c-cat' });
      cl.textContent = cat.label;
      svg.appendChild(cl);
      if (cat.sub) {
        const cs = el('text', { x: padL + ci * gband + gband / 2, y: H - padB + (cfg.twoLine ? 40 : 24), 'text-anchor': 'middle', class: 'c-cat2' });
        cs.textContent = cat.sub;
        svg.appendChild(cs);
      }

      cat.values.forEach((v, si) => {
        const x = gx + si * (barW + gap), y = yOf(v), h = padT + plotH - y;
        const g = el('g', { class: 'bar-g' });
        const p = el('path', { d: barPath(x, y, barW, h, 4), fill: series[si].color, class: 'bar-rect' });
        p.addEventListener('mousemove', (ev) => {
          showTip(container, ev as MouseEvent, (series.length > 1 ? series[si].name + ' · ' : '') + cat.label, cfg.fmt(v));
        });
        p.addEventListener('mouseleave', () => hideTip(container));
        g.appendChild(p);
        svg.appendChild(g);
        const vl = el('text', { x: x + barW / 2, y: y - 9, 'text-anchor': 'middle', class: 'c-val bar-lab' });
        vl.textContent = cfg.fmt(v);
        svg.appendChild(vl);
      });
    });

    container.appendChild(svg);
    const tip = document.createElement('div');
    tip.className = 'tip';
    container.appendChild(tip);
    container.__tip = tip;
  }

  /* ---------- chart data ---------- */
  function buildChart(id: string) {
    const c = document.getElementById(id) as ChartBox | null;
    if (!c) return;
    const teal = cssv('--ex-s1'), carmine = cssv('--ex-s2'), ochre = cssv('--ex-hl');
    const kind = c.getAttribute('data-chart');

    if (kind === 'c1') {
      drawColumns(c, {
        ymax: 80, ticks: [0, 20, 40, 60, 80], barW: 64,
        series: [{ name: 'Success rate', color: teal }],
        cats: [
          { label: 'No bonus', values: [43.5] },
          { label: 'Bonus, any time', values: [60.5] },
          { label: 'Bonus, early only', values: [67.0] },
        ],
        fmt: (v) => v.toFixed(1) + '%',
        aria: 'Column chart of crowdfunding success rates: no bonus 43.5 percent, bonus any time 60.5 percent, early bonus 67 percent.',
      });
      /* Highlight the winning bar. */
      c.querySelectorAll('.bar-rect')[2]?.setAttribute('fill', ochre);
    }

    if (kind === 'c2') {
      drawColumns(c, {
        ymax: 60, ticks: [0, 20, 40, 60], barW: 48, twoLine: true,
        series: [
          { name: 'Bonus assigned at random', color: carmine },
          { name: 'Entrepreneur chooses to offer a bonus', color: teal },
        ],
        cats: [
          { label: 'Good projects', values: [17.5, 45.9] },
          { label: 'Bad projects', values: [13.5, 12.7] },
        ],
        fmt: (v) => v.toFixed(1) + '%',
        aria: 'Grouped columns: good projects funded 17.5 percent under random bonuses and 45.9 percent when entrepreneurs choose; bad projects 13.5 and 12.7 percent.',
      });
      const lg = document.getElementById('legend2');
      if (lg) {
        lg.innerHTML =
          '<span class="lg"><span class="sw" style="background:' + teal + '"></span>Entrepreneur chooses to offer a bonus</span>' +
          '<span class="lg"><span class="sw" style="background:' + carmine + '"></span>Bonus assigned at random</span>';
      }
    }

    if (kind === 'c3') {
      drawColumns(c, {
        ymax: 40, ticks: [0, 10, 20, 30, 40], barW: 64,
        series: [{ name: 'Assembly success rate', color: teal }],
        cats: [
          { label: 'No bonus', values: [10] },
          { label: 'With refund bonus', values: [25] },
        ],
        fmt: (v) => v + '%',
        aria: 'Column chart: share of final rounds in which the assembly succeeded, 10 percent without a bonus and 25 percent with a bonus.',
      });
      c.querySelectorAll('.bar-rect')[1]?.setAttribute('fill', ochre);
    }
  }

  const CHART_IDS = ['chart1', 'chart2', 'chart3'];
  CHART_IDS.forEach(buildChart);

  /* Animate each chart once, when it first scrolls into view. */
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.35 },
  );
  ROOT.querySelectorAll('.chart').forEach((c) => io.observe(c));

  /* The SVG fills are read from CSS at draw time rather than inherited, so a
     change of system theme has to redraw them. The site has no theme toggle;
     this is the only way the palette can move under a rendered chart. */
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  mq.addEventListener('change', () => CHART_IDS.forEach(buildChart));

  /* ---------- payoff matrix engine (drives both tables) ---------- */
  interface MxState {
    hSucc: string; hFail: string;
    in_succ: string; in_fail: string; out_succ: string; out_fail: string;
    cap_in_succ: string; cap_in_fail: string; cap_out_succ: string; cap_out_fail: string;
    flip?: string[]; colhi?: string[]; dominant?: 'in' | 'out';
    lead?: string; caption: string;
  }

  const MATRICES: Record<string, (key: string) => void> = {};
  const CELLS = ['in_succ', 'in_fail', 'out_succ', 'out_fail'] as const;

  function initMatrix(rootId: string, STATES: Record<string, MxState>, initial: string) {
    const root = document.getElementById(rootId);
    if (!root) return;
    const capEl = root.querySelector('.mx-caption') as HTMLElement;
    const btns = Array.from(root.querySelectorAll('.mx-btn'));

    function apply(key: string) {
      const d = STATES[key];
      (root!.querySelector('[data-h="succ"]') as HTMLElement).textContent = d.hSucc;
      (root!.querySelector('[data-h="fail"]') as HTMLElement).textContent = d.hFail;

      CELLS.forEach((k) => {
        const cell = root!.querySelector('[data-c="' + k + '"]') as HTMLElement;
        (cell.querySelector('.pay') as HTMLElement).textContent = d[k];
        (cell.querySelector('.cap') as HTMLElement).textContent = d[('cap_' + k) as keyof MxState] as string;
        cell.classList.toggle('flip', (d.flip || []).indexOf(k) > -1);
        cell.classList.toggle('colhi', (d.colhi || []).indexOf(k) > -1);
      });

      root!.querySelector('[data-row="in"]')!.classList.toggle('dominant', d.dominant === 'in');
      root!.querySelector('[data-row="out"]')!.classList.toggle('dominant', d.dominant === 'out');
      capEl.innerHTML = (d.lead ? '<b>' + d.lead + '</b>' : '') + d.caption;

      btns.forEach((b) => {
        const on = b.getAttribute('data-k') === key;
        b.classList.toggle('on', on);
        b.setAttribute('aria-selected', String(on));
      });
    }

    btns.forEach((b) => b.addEventListener('click', () => apply(b.getAttribute('data-k')!)));
    MATRICES[rootId] = apply;
    apply(initial);
  }

  /* The bare public good game (section 1). */
  initMatrix(
    'mxGame',
    {
      game: {
        hSucc: 'Enough others contribute', hFail: 'Too few others contribute',
        in_succ: '+30', cap_in_succ: 'the dike is built, you paid your share',
        in_fail: '−20', cap_in_fail: 'your money is spent and no dike rises',
        out_succ: '+50', cap_out_succ: 'the dike is built and you paid nothing',
        out_fail: '0', cap_out_fail: 'nothing spent, nothing gained',
        dominant: 'out',
        lead: 'Withholding wins in both columns. ',
        caption: 'It pays 50 against 30 when enough others contribute, and 0 against −20 when too few do. Withholding is a dominant strategy, every family reasons its way to the same conclusion, and the dike goes unbuilt. This is the public good problem in its familiar prisoner’s dilemma form.',
      },
      assurance: {
        hSucc: 'Enough others contribute', hFail: 'Too few others contribute',
        in_succ: '+30', cap_in_succ: 'the dike is built, you paid your share',
        in_fail: '−20', cap_in_fail: 'your money is spent and no dike rises',
        out_succ: '+50', cap_out_succ: 'the dike is built and you paid nothing',
        out_fail: '0', cap_out_fail: 'nothing spent, nothing gained',
        colhi: ['in_fail', 'out_fail'],
        lead: 'Take the second column alone. ',
        caption: 'Too few of your neighbors are contributing, so no dike goes up and there is nothing for anyone to ride on. You withhold because a contribution would be thrown away on a dike that never rises. What stops you here is the absence of assurance.',
      },
      freeride: {
        hSucc: 'Enough others contribute', hFail: 'Too few others contribute',
        in_succ: '+30', cap_in_succ: 'the dike is built, you paid your share',
        in_fail: '−20', cap_in_fail: 'your money is spent and no dike rises',
        out_succ: '+50', cap_out_succ: 'the dike is built and you paid nothing',
        out_fail: '0', cap_out_fail: 'nothing spent, nothing gained',
        colhi: ['in_succ', 'out_succ'],
        lead: 'Now the first column alone. ',
        caption: 'Enough of your neighbors are contributing that the dike goes up whatever you do. Assurance plays no part, since the outcome is already settled. You withhold because withholding pays 50 where contributing pays 30. What stops you here is the temptation to ride free.',
      },
    },
    'game',
  );

  /* The three contracts (section 3). */
  initMatrix(
    'mxContracts',
    {
      a: {
        hSucc: 'Enough others pledge', hFail: 'Too few others pledge',
        in_succ: '+30', cap_in_succ: 'the good is built, you paid your share',
        in_fail: '0', cap_in_fail: 'refunded in full',
        out_succ: '+50', cap_out_succ: 'the good is built and you paid nothing',
        out_fail: '0', cap_out_fail: 'no pledge, no payoff',
        lead: 'The refund erases the loss. ',
        caption: 'Pledging into a campaign that falls short now costs nothing rather than 20, so the fear of a wasted contribution is gone. Two problems survive. Abstaining still beats pledging whenever the others carry the project, 50 against 30. And when you expect too few others to pledge, pledging gains you nothing, so universal abstention holds together on shared pessimism alone.',
      },
      b: {
        hSucc: 'Enough others pledge', hFail: 'Too few others pledge',
        in_succ: '+30', cap_in_succ: 'the good is built, you paid your share',
        in_fail: '+10', cap_in_fail: 'refunded, plus the bonus',
        out_succ: '+50', cap_out_succ: 'the good is built and you paid nothing',
        out_fail: '0', cap_out_fail: 'no pledge, no payoff',
        flip: ['in_fail'],
        lead: 'The bonus changes the second column. ',
        caption: 'Someone who expects the project to fail now earns 10 by pledging and 0 by abstaining, so no one has reason to sit out in anticipation of failure. Every outcome with too few pledges unravels, and every equilibrium that remains provides the good. Pledging is still not dominant, since anyone confident of success would rather be carried, at 50 against 30.',
      },
      c: {
        hSucc: 'All the others pledge', hFail: 'Some of the others abstain',
        in_succ: '+30', cap_in_succ: 'everyone pledged, the good is built',
        in_fail: '+10', cap_in_fail: 'refunded, plus the bonus',
        out_succ: '0', cap_out_succ: 'the contract needed your pledge, so it fails',
        out_fail: '0', cap_out_fail: 'no pledge, no payoff',
        dominant: 'in',
        lead: 'Pledging now wins in both columns. ',
        caption: 'Requiring every pledge removes the option of being carried, so the 50 disappears. Pledging pays more whatever the others do, 30 against 0 and 10 against 0, which makes it a dominant strategy. The dominance has changed rows since we began.',
      },
    },
    'a',
  );

  /* Inline terms in the prose drive the table they name. */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  ROOT.querySelectorAll('button.term[data-mx]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-mx')!;
      const root = document.getElementById(id);
      const apply = MATRICES[id];
      if (!apply || !root) return;
      apply(btn.getAttribute('data-mxk')!);
      root.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    });
  });
</script>
